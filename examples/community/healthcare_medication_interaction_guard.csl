  // Severity: MODERATE, Effect: ADDITIVE
  // Additive myocardial depression and hypotension under general anesthesia
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_beta_blocker_inhaled_volatile_anesthetic {
    WHEN new_drug_class == "BETA BLOCKER" AND INHALED_VOLATILE_ANESTHETIC == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // BETA BLOCKER + ANTIPSYCHOTIC
  // Severity: MODERATE, Effect: ADDITIVE
  // Additive QTc prolongation and hypotension; some antipsychotics inhibit CYP2D6 → increased beta-blocker levels
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_beta_blocker_antipsychotic {
    WHEN new_drug_class == "BETA BLOCKER" AND ANTIPSYCHOTIC == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
