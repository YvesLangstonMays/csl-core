  // Severity: MAJOR, Effect: MEDICAL REVERSAL
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_cholinesterase_inhibitor_neuromuscular_blocker {
    WHEN new_drug_class == "CHOLINESTERASE INHIBITOR" AND NEUROMUSCULAR_BLOCKER == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "MEDICAL REVERSAL"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // CHOLINESTERASE INHIBITOR + BETA BLOCKER
  // Severity: MODERATE, Effect: ADDITIVE
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_cholinesterase_inhibitor_beta_blocker {
    WHEN new_drug_class == "CHOLINESTERASE INHIBITOR" AND BETA_BLOCKER == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }
