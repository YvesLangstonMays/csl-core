  // -----------------------------------------------------------
  // BETA BLOCKER + CHOLINESTERASE INHIBITOR
  // Severity: MODERATE, Effect: ADDITIVE
  // Cholinesterase inhibitors slow heart rate via vagal tone; additive bradycardia with beta-blockers
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_beta_blocker_cholinesterase_inhibitor {
    WHEN new_drug_class == "BETA BLOCKER" AND CHOLINESTERASE_INHIBITOR == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // BETA BLOCKER + DIURETIC
  // Severity: MILD, Effect: ADDITIVE
  // Additive blood pressure lowering; minor risk of electrolyte-induced arrhythmia with hypokalemia from loop/thiazide diuretics
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_beta_blocker_diuretic {
    WHEN new_drug_class == "BETA BLOCKER" AND DIURETIC == TRUE
    THEN interaction_severity = "MILD"
    AND interaction_effect = "ADDITIVE"
  }

  // -----------------------------------------------------------
  // BETA BLOCKER + STIMULANT
  // Severity: MODERATE, Effect: MEDICAL REVERSAL
  // Stimulants (amphetamines, pseudoephedrine) activate beta-adrenergic receptors; beta-blockers oppose this, leaving alpha stimulation unopposed → hypertension
  // -----------------------------------------------------------
  STATE_CONSTRAINT interaction_beta_blocker_stimulant {
    WHEN new_drug_class == "BETA BLOCKER" AND STIMULANT == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "MEDICAL REVERSAL"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
