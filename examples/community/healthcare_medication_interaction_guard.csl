// =============================================================
// Healthcare Medication Interaction
// Goal: Restrict prescription of interacting medications
// Written by: Yves-Langston Mays
// =============================================================

CONFIG {
  ENFORCEMENT_MODE: BLOCK
  CHECK_LOGICAL_CONSISTENCY = TRUE
}

DOMAIN healthcare_medication_interaction {

  VARIABLES {
    // Medication Class Being Prescribed
    new_drug_class: "SSRI", "SNRI", "ANTICOAGULANT", "OPIOID", "BENZODIAZEPINE", "ACE INHIBITOR", "ARB", "BETA BLOCKER", "CALCIUM CHANNEL BLOCKER", "DIURETIC", "STATIN",
    "ANTIPLATELET", "ANTIARRHYTHMIC", "STIMULANT", "ANTIPSYCHOTIC", "NSAID", "ANTICONVULSANT", "PENICILLIN", "CEPHALOSPORIN", "MACROLIDE", "TETRACYCLINE", "FLUOROQINOLONE",
    "ANTIVIRAL", "ANTIFUNGAL", "BIGUANIDE", "SULFONYLUREA", "INSULIN", "THYROID HORMONE", "CORTICOSTEROID", "BETA 2 AGONIST", "LEUKOTRIENE RECEPTOR ANTAGONIST",
    "PROTON PUMP INHIBITOR", "H2 BLOCKER", "MONOCLONAL ANTIBODY", "ALKYLATING AGENT", "IMMUNOSUPPRESSANT", "CHOLINESTERASE INHIBITOR", "COMT INHIBITOR", "OREXIN RECEPTOR AGONIST",
    "TRIPTAN", "ALPHA 1 BLOCKER", "5 ALPHA REDUCTASE INHIBITOR", "ANTICHOLINERGIC", "VASOPRESSIN RECEPTOR ANTAGONIST", "TNF INHIBITOR", "JAK INHIBITOR", "XANTHINE OXIDASE INHIBITOR",
    "INHALED ANTICHOLINERGIC", "MAST CELL STABILIZER", "PROSTAGLANDING ANALOG", "CARBONIC ANHYDRASE INHIBITOR", "VASOPRESSOR", "THROMBOLYTICS", "NEUROMUSCULAR BLOCKER",
    "BIPHOSPHONATE", "SERM", "SARM", "AROMATASE INHIBITOR", "GNRH MODULATOR", "SGLT2 INHIBITOR", "NEPRILYSIN INHIBITOR", "ALDOSTERONE ANTAGONIST", "ERYTHROPOIESIS STIMULATOR",
    "THROMBOPOIETIN RECEPTOR AGONIST", "IRON CHELATOR", "5HT3 RECEPTOR ANTAGONIST", "NK1 RECEPTOR ANTAGONIST", "GI MOTILITY AGENT", "TOPICAL RETINOID", "CALCINEURIN INHIBITOR",
    "CHEMICAL CHELATOR", "CHOLINESTERASE REACTIVATOR", "OXAZOLIDINONE", "LIPOGLYCOPEPTIDE", "ACT", "INSTI", "PROTEASE INHIBITOR", "INHALED VOLATILE ANESTHETIC", "INTRAVENOUS INDUCTION AGENT",
    "ESTER ANESTHETIC", "AMIDE ANESTHETIC", "ANTICHOLINESTERASE REVERSAL AGENT", "SELECTIVE RELAXANT BINDING AGENT", "ANTACID", "DIVALENT CATION", "AZOLE ANTIFUNGAL", "METHOTREXATE",
    "ORAL CONTRACEPTIVE" }

    // Interaction Severity
    interaction_severity: {"NONE", "MILD", "MODERATE", "MAJOR", "CONTRAINDICATED"}

    // Interaction Effect
    interaction_effect: {"ADDITIVE", "SYNERGISTIC", "THERAPEUTIC FAILURE", "MEDICAL REVERSAL", "ALTERED ABSORPTION", "ALTERED METABOLISM"}

    // NKA 
    no_known_allergies: BOOLEAN


    // -----------------------------------------------------------
    // Patient Current Drug Statuses
    // -----------------------------------------------------------

    SSRI: BOOLEAN
    SNRI: BOOLEAN
    ANTICOAGULANT: BOOLEAN
    OPIOID: BOOLEAN
    BENZODIAZEPINE: BOOLEAN
    ACE_INHIBITOR: BOOLEAN
    ARB: BOOLEAN
    BETA_BLOCKER: BOOLEAN
    CALCIUM_CHANNEL_BLOCKER: BOOLEAN
    DIURETIC: BOOLEAN
    STATIN: BOOLEAN
    ANTIPLATELET: BOOLEAN
    ANTIARRHYTHMIC: BOOLEAN
    STIMULANT: BOOLEAN
    ANTIPSYCHOTIC: BOOLEAN
    NSAID: BOOLEAN
    ANTICONVULSANT: BOOLEAN
    PENICILLIN: BOOLEAN
    CEPHALOSPORIN: BOOLEAN
    MACROLIDE: BOOLEAN
    TETRACYCLINE: BOOLEAN
    FLUOROQUINOLONE: BOOLEAN
    ANTIVIRAL: BOOLEAN
    ANTIFUNGAL: BOOLEAN
    BIGUANIDE: BOOLEAN
    SULFONYLUREA: BOOLEAN
    INSULIN: BOOLEAN
    THYROID_HORMONE: BOOLEAN
    CORTICOSTEROID: BOOLEAN
    BETA_2_AGONIST: BOOLEAN
    LEUKOTRIENE_RECEPTOR_ANTAGONIST: BOOLEAN
    PROTON_PUMP_INHIBITOR: BOOLEAN
    H2_BLOCKER: BOOLEAN
    MONOCLONAL_ANTIBODY: BOOLEAN
    ALKYLATING_AGENT: BOOLEAN
    IMMUNOSUPPRESSANT: BOOLEAN
    CHOLINESTERASE_INHIBITOR: BOOLEAN
    COMT_INHIBITOR: BOOLEAN
    OREXIN_RECEPTOR_AGONIST: BOOLEAN
    TRIPTAN: BOOLEAN
    ALPHA_1_BLOCKER: BOOLEAN
    FIVE_ALPHA_REDUCTASE_INHIBITOR: BOOLEAN
    ANTICHOLINERGIC: BOOLEAN
    VASOPRESSIN_RECEPTOR_ANTAGONIST: BOOLEAN
    TNF_INHIBITOR: BOOLEAN
    JAK_INHIBITOR: BOOLEAN
    XANTHINE_OXIDASE_INHIBITOR: BOOLEAN
    INHALED_ANTICHOLINERGIC: BOOLEAN
    MAST_CELL_STABILIZER: BOOLEAN
    PROSTAGLANDIN_ANALOG: BOOLEAN
    CARBONIC_ANHYDRASE_INHIBITOR: BOOLEAN
    VASOPRESSOR: BOOLEAN
    THROMBOLYTIC: BOOLEAN
    NEUROMUSCULAR_BLOCKER: BOOLEAN
    BISPHOSPHONATE: BOOLEAN
    SERM: BOOLEAN
    SARM: BOOLEAN
    AROMATASE_INHIBITOR: BOOLEAN
    GNRH_MODULATOR: BOOLEAN
    SGLT2_INHIBITOR: BOOLEAN
    NEPRILYSIN_INHIBITOR: BOOLEAN
    ALDOSTERONE_ANTAGONIST: BOOLEAN
    ERYTHROPOIESIS_STIMULATOR: BOOLEAN
    THROMBOPOIETIN_RECEPTOR_AGONIST: BOOLEAN
    IRON_CHELATOR: BOOLEAN
    HT3_RECEPTOR_ANTAGONIST: BOOLEAN
    NK1_RECEPTOR_ANTAGONIST: BOOLEAN
    GI_MOTILITY_AGENT: BOOLEAN
    TOPICAL_RETINOID: BOOLEAN
    CALCINEURIN_INHIBITOR: BOOLEAN
    CHEMICAL_CHELATOR: BOOLEAN
    CHOLINESTERASE_REACTIVATOR: BOOLEAN
    OXAZOLIDINONE: BOOLEAN
    LIPOGLYCOPEPTIDE: BOOLEAN
    ACT: BOOLEAN
    INSTI: BOOLEAN
    PROTEASE_INHIBITOR: BOOLEAN
    INHALED_VOLATILE_ANESTHETIC: BOOLEAN
    INTRAVENOUS_INDUCTION_AGENT: BOOLEAN
    ESTER_ANESTHETIC: BOOLEAN
    AMIDE_ANESTHETIC: BOOLEAN
    ANTICHOLINESTERASE_REVERSAL_AGENT: BOOLEAN
    SELECTIVE_RELAXANT_BINDING_AGENT: BOOLEAN
    ANTACID: BOOLEAN
    DIVALENT_CATION: BOOLEAN
    AZOLE_ANTIFUNGAL: BOOLEAN
    METHOTREXATE: BOOLEAN
    ORAL_CONTRACEPTIVE: BOOLEAN


    // Pt Context Variables
    // age = age, bmi = body mass index, bsa = body surface area, preg = pregnancy_status, cm = current_meds, egfr = egfr less than 30
    // seizure = history of seizure
    pt_age: INT
    pt_bmi: FLOAT
    pt_bsa: FLOAT
    pt_preg: BOOLEAN
    pt_cm: STRING
    pt_egf: BOOLEAN
    pt_seizure: BOOLEAN

    // Pharmacist SignOff
    signoff: BOOLEAN

    // Escalation flag that is set to true when manual review is required
    requires_escalation: BOOLEAN

}

    // ===========================================================
    // SECTION 1: GLOBAL SEVERITY ESCALATION RULES
    // ===========================================================

    // -----------------------------------------------------------
    // All CONTRAINDICATED pairs must escalate regardles of source
    // -----------------------------------------------------------
      STATE_CONSTRAINT escalate_contraindicated {
      WHEN interaction_severity == "CONTRAINDICATED"
      THEN requires_escalation MUST NOT BE FALSE
    }

    // -----------------------------------------------------------
    // All MAJOR pairs must escalate for human review
    // -----------------------------------------------------------
      STATE_CONSTRAINT escalate_major {
      WHEN interaction_severity == "MAJOR"
      THEN requires_escalation MUST BE TRUE
    }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE interactions
  // -----------------------------------------------------------

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + ANTIARRHYTHMIC
  // Severity: MAJOR, Effect: ADDITIVE
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_antiarrhythmic {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND ANTIARRHYTHMIC == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + ANTIPSYCHOTIC
  // Severity: MAJOR, Effect: ADDITIVE
  // -----------------------------------------------------------
  
  STATE_CONSTRAINT interaction_fluoroquinolone_antipsychotic {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND ANTIPSYCHOTIC == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + NSAID
  // Severity: MODERATE, Effect: SYNERGISTIC
  // Escalate if pt has seizure history
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_nsaid {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND NSAID == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "SYNERGISTIC"
    AND requires_escalation MUST BE TRUE
  }

  STATE_CONSTRAINT interaction_fluoroquinolone_nsaid_seizure {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND NSAID == TRUE AND pt_seizure == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "SYNERGISTIC"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + ANTACID
  // Severity: MAJOR, Effect: ALTERED ABSORPTION
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_antacid {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND ANTACID == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "ALTERED ABSORPTION"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + DIVALENT_CATION
  // Severity: MAJOR, Effect: ALTERED ABSORPTION
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_divalent_cation {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND DIVALENT_CATION == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "ALTERED ABSORPTION"
    AND requires_escalation MUST BE TRUE
  }
  
  // -----------------------------------------------------------
  // FLUOROQUINOLONE + ANTICOAGULANT
  // Severity: MODERATE, Effect: ADDITIVE
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_anticoagulant {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND ANTICOAGULANT == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + ORAL_CONTRACEPTIVE
  // Severity: MILD, Effect: THERAPEUTIC FAILURE
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_oral_contraceptive {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND ORAL_CONTRACEPTIVE == TRUE
    THEN interaction_severity = "MILD"
    AND interaction_effect = "THERAPEUTIC FAILURE"
    AND requires_escalation MUST BE TRUE
  }
  

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + STATIN
  // Severity: MILD, Effect: ADDITIVE
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_statin {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND STATIN == TRUE
    THEN interaction_severity = "MILD"
    AND interaction_effect = "ADDITIVE"
  }
 
  // -----------------------------------------------------------
  // FLUOROQUINOLONE + CORTICOSTEROID
  // Severity: MODERAT, Effect: SYNERGISTIC
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_corticosteroid {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND CORTICOSTEROID == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "SYNERGISTIC"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + INSULIN
  // Severity: MODERATE, Effect: ADDITIVE
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_insulin {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND INSULIN == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + SULFONYLUREA
  // Severity: MODERATE, Effect: ADDITIVE
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_sulfonylurea {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND SULFONYLUREA == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ADDITIVE"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + METHOTREXATE
  // Severity: MODERATE, Effect: ALTERED METABOLISM
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_methotrexate {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND METHOTREXATE == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ALTERED METABOLISM"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + CYCLOSPORINE (CALCINEURIN INHIBITOR)
  // Severity: MODERATE, Effect: ALTERED METABOLISM
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_calcineurin_inhibitor {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND CALCINEURIN_INHIBITOR == TRUE
    THEN interaction_severity = "MODERATE"
    AND interaction_effect = "ALTERED METABOLISM"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + THEOPHYLLINE
  // Severity: MAJOR, Effect: ALTERED METABOLISM
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_xanthine_oxidase_inhibitor {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND XANTHINE_OXIDASE_INHIBITOR == TRUE
    THEN interaction_severity = "MAJOR"
    AND interaction_effect = "ALTERED METABOLISM"
    AND requires_escalation MUST BE TRUE
  }

  // -----------------------------------------------------------
  // FLUOROQUINOLONE + PROTON PUMP INHIBITOR
  // Severity: MILD, Effect: ALTERED ABSORPTION
  // -----------------------------------------------------------

  STATE_CONSTRAINT interaction_fluoroquinolone_ppi {
    WHEN new_drug_class == "FLUOROQUINOLONE" AND PROTON_PUMP_INHIBITOR == TRUE
    THEN interaction_severity = "MILD"
    AND interaction_effect = "ALTERED ABSORPTION"
  }