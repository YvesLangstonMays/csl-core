// =============================================================
// Healthcare Medication Interaction
// Goal: Basic logic to restrict large external transfers.
// =============================================================

CONFIG {
  ENFORCEMENT_MODE: BLOCK
  CHECK_LOGICAL_CONSISTENCY = TRUE
}

DOMAIN HelloWorld {

  VARIABLES {
    // Medication Class Being Prescribed
    new_drug_class: "SSRI", "SNRI", "ANTICOAGULANT", "OPIOID", "BENZODIAZEPINE", "ACE INHIBITOR", "ARB", "BETA BLOCKER", "CALCIUM CHANNEL BLOCKER", "DIURETIC", "STATIN",
    "ANTIPLATELET", "ANTIARRHYHMIC", "STIMULANT", "ANTIPSYCHOTIC", "NSAID", "ANTICONVULSANT", "PENICILLIN", "CEPHALOSPORIN", "MACROLIDE", "TETRACYCLINE", "FLUOROQINOLONE",
    "ANTIVIRAL", "ANTIFUNGAL", "BIGUANIDE", "SULFONYLUREA", "INSULIN", "THYROID HORMONE", "CORTICOSTEROID", "BETA 2 AGONIST", "LEUKOTRIENE RECEPTOR ANTAGONIST",
    "PROTON PUMP INHIBITOR", "H2 BLOCKER", "MONOCLONAL ANTIBODY", "ALKYLATING AGENT", "IMMUNOSUPPRESSANT", "CHOLINESTERASE INHIBITOR", "COMT INHIBITOR", "OREXIN RECEPTOR AGONIST",
    "TRIPTAN", "ALPHA 1 BLOCKER", "5 ALPHA REDUCTASE INHIBITOR", "ANTICHOLINERGIC", "VASOPRESSIN RECEPTOR ANTAGONIST", "TNF INHIBITOR", "JAK INHIBITOR", "XANTHINE OXIDASE INHIBITOR",
    "INHALED ANTICHOLINERGIC", "MAST CELL STABILIZER", "PROSTAGLANDING ANALOG", "CARBONIC ANHYDRASE INHIBITOR", "VASOPRESSOR", "THROMBOLYTICS", "NEUROMUSCULAR BLOCKER",
    "BIPHOSPHONATE", "SERM", "SARM", "AROMATASE INHIBITOR", "GNRH MODULATOR", "SGLT2 INHIBITOR", "NEPRILYSIN INHIBITOR", "ALDOSTERONE ANTAGONIST", "ERYTHROPOIESIS STIMULATOR",
    "THROMBOPOIETIN RECEPTOR AGONIST", "IRON CHELATOR", "5HT3 RECEPTOR ANTAGONIST", "NK1 RECEPTOR ANTAGONIST", "GI MOTILITY AGENT", "TOPICAL RETINOID", "CALCINEURIN INHIBITOR",
    "CHEMICAL CHELATOR", "CHOLINESTERASE REACTIVATOR", "OXAZOLIDINONE", "LIPOGLYCOPEPTIDE", "ACT", "INSTI", "PROTEASE INHIBITOR", "INHALED VOLATILE ANESTHETIC", "INTRAVENOUS INDUCTION AGENT",
    "ESTER ANESTHETIC", "AMIDE ANESTHETIC", "ANTICHOLINESTERASE REVERSAL AGENT", "SELECTIVE RELAXANT BINDING AGENT", "" }

    // Interaction Severity
    interaction_severity: {"NONE", "MILD", "MODERATE", "MAJOR", "CONTRAINDICATED"}

    // Interaction Effect
    interaction_effect: {"ADDITIVE", "SYNERGISTIC", "THERAPEUTIC FAILURE", "MEDICAL REVERSAL", "ALTERED ABSORPTION", "ALTERED METABOLISM"}

    // NKA 
    no_known_allergies: BOOLEAN

    // SSRI status
    SSRI: BOOLEAN

    // Anticoagulant status
    ANTICOAGULANT: BOOLEAN

    // Opioid status
    OPIOID: BOOLEAN

    // Benzo status
    BENZODIAZEPINE: BOOLEAN




    // Where the money is going
    destination: {"INTERNAL", "EXTERNAL"}
  }

  // -----------------------------------------------------------
  // Rule: Transfers of 100 or more must stay INTERNAL.
  //       (Small transfers < 100 are allowed anywhere)
  // -----------------------------------------------------------
  STATE_CONSTRAINT limit_large_transfers {
    WHEN amount >= 100
    THEN destination MUST BE "INTERNAL"
  }
}